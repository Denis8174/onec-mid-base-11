#КонецОбласти




#Область МоиПроцедуры

&НаКлиенте
Процедура ДЗ_ПересчетТаблиц()
	
	
	Для Каждого Строка из Объект.Товары Цикл
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;
	Для Каждого Строка из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;
	
КонецПроцедуры  

&НаКлиенте
Асинх Процедура ВопросОбИзменение()
	
	Если ЗначениеЗаполнено(Объект.Товары) Или ЗначениеЗаполнено(Объект.Услуги) Тогда
		ОтветНаВопрос = Ждать ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);
		Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
			ДЗ_ПересчетТаблиц();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры     

&НаКлиенте
Процедура ДЗ_СогласованнаяСкидкаПриИзменении(Элемент)
	ВопросОбИзменение();
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьСкидкуКоманда(Команда)
	ДЗ_ПересчетТаблиц();
КонецПроцедуры

 &НаСервере
 Процедура  СоздатьКнопку(ЭтаФорма)
	 Команда = Команды.Добавить("ДЗ_РассчитатьСкидку");
	 Команда.Заголовок = "Рассчитать скидку";
	 Команда.Действие = "РассчитатьСкидкуКоманда";
	 
	 
	 КнопкаФормы = Элементы.Добавить("РассчитатьСкидкуКоманда", Тип("КнопкаФормы"), ЭтаФорма.Элементы.ГруппаШапкаЛево);
	 КнопкаФормы.ИмяКоманды = "ДЗ_РассчитатьСкидку";
	 КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
 КонецПроцедуры
 #КонецОбласти







